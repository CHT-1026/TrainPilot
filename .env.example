# Copy to .env.local (local) or .env (deployment) and fill real values.
# Never commit real secrets.

OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=deepseek-v4-flash
# 当前本机使用：https://myai.bupt.edu.cn/llm-gw/v1
# 也可指向：https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
OPENAI_ENABLE_THINKING=false

# 语义向量（可独立于对话网关）
# 离线可复现：RAG_EMBEDDING_PROVIDER=hash，RAG_EMBEDDING_DIM=384
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_BATCH=10

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=lantu-agent-platform

REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_DAYS=30

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=oa_local
MYSQL_PASSWORD=
MYSQL_DATABASE=xiaodi_smart_oa

SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

KB_TOP_K=6
KB_MIN_SCORE=9.0

# 企业知识检索与问答（lantu 命名空间，与 OA default 隔离）
RAG_NAMESPACE=lantu
RAG_TOP_K=8
RAG_CANDIDATE_K=60
RAG_RRF_K=60
RAG_MAX_CHUNKS_PER_DOC=4
RAG_MIN_SCORE=0.18
# 独立离线实验：hash/384须使用匹配重建的索引，不得替代现有语义1024维索引。
RAG_USE_LLM=auto
RAG_LLM_MODEL=deepseek-v4-flash
RAG_LLM_TIMEOUT=60
# 企业RAG在应用层显式重试并计数；SDK内部重试固定为0。
RAG_REASONING_TOP_K=32
RAG_MAX_CONTEXT_CHARS=18000

CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_SECONDS=300

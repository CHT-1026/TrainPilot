# Local-only demonstration; generate your own MYSQL_PASSWORD and SECRET_KEY.
OPENAI_API_BASE=http://127.0.0.1:8011/v1
OPENAI_API_KEY=local-trainpilot-v7
OPENAI_MODEL=trainpilot-lora
OPENAI_ENABLE_THINKING=false
NO_PROXY=127.0.0.1,localhost,::1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=trainpilot_demo
MYSQL_USER=trainpilot_local
MYSQL_PASSWORD=
SECRET_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
RAG_TOOL_CALLS=true
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_DIM=384
RAG_EMBEDDING_MODEL=lantu-hash-384
RAG_USE_LLM=true
RAG_LLM_MODEL=trainpilot-lora
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0
LANGSMITH_TRACING=false

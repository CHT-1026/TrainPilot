{
  "model": {
    "vocab_size": 6400,
    "hidden_size": 768,
    "num_layers": 8,
    "num_heads": 8,
    "num_kv_heads": 4,
    "intermediate_size": 2432,
    "max_seq_len": 340,
    "max_position_embeddings": 32768,
    "initializer_range": 0.02,
    "flash_attn": true
  },
  "data": {
    "tokenizer_path": "assets/tokenizer.json",
    "train_path": "data/train.jsonl",
    "val_path": "data/val.jsonl"
  },
  "training": {
    "device": "cuda",
    "dtype": "bfloat16",
    "epochs": 2,
    "batch_size": 32,
    "accumulation_steps": 8,
    "grad_clip": 1.0,
    "lr_schedule": "cosine",
    "log_interval": 20,
    "save_interval": 100,
    "learning_rate": 0.0005,
    "weight_decay": 0.01,
    "seed": 42,
    "num_workers": 0,
    "output_dir": "runs/pretrain"
  }
}
